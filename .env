PUBLIC_PB_BASE_URI=https://blablind.jota.one

# YouTube search backends, tried in order by /proxy/search:
#   1. InnerTube  — YouTube's own web API. No key, no quota. Primary, nothing to configure.
#   2. Data API   — official API, used only if SECRETS_YOUTUBE_API_KEY is set below.
#                   Costs ~101 quota units per search (~99 searches/day on the free tier).
#   3. Invidious  — last resort. Public instances are mostly dead; override the list if one revives.
# Prod: set via apps.yaml `secrets:` in jota-one/infra (Bitwarden), which the .env
# generator flattens to SECRETS_YOUTUBE_API_KEY. Keep the prefix locally too.
# SECRETS_YOUTUBE_API_KEY=
# INVIDIOUS_INSTANCES=https://yewtu.be,https://inv.nadeko.net
