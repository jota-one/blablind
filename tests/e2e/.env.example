# Copy to tests/e2e/.env (gitignored) and source it, or export inline before
# running `pnpm test:e2e`.

# Astro dev server under test
BASE_URL=http://localhost:4321

# PocketBase the Node seed client talks to. Must be the SAME instance the browser
# app reaches via PUBLIC_PB_BASE_URI (.env.local). On a LAN dev box, use the IP.
PB_URL=http://127.0.0.1:8093

# Superuser creds — required for teardown (sessions/videos have no delete rule)
# and for the password-reset spec (seeds a user, points PB mail at Mailpit).
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Mailpit HTTP API — password-reset spec reads caught emails here.
# Install: brew install mailpit ; run: mailpit (web/API :8025, SMTP :1025)
MAILPIT_URL=http://localhost:8025
