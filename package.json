{
  "name": "blablind",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "test:unit": "node --experimental-strip-types --test 'tests/unit/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:clean": "node --experimental-strip-types tests/e2e/clean.ts",
    "tutorial:seed": "node --experimental-strip-types tests/tutorial/seed.ts",
    "tutorial:shoot": "node --experimental-strip-types tests/tutorial/shoot.ts",
    "tutorial:webp": "zsh tests/tutorial/to-webp.sh",
    "db": "cd pb && ./pocketbase serve --http=127.0.0.1:8093",
    "db:custom": "cd pb && go build -o pocketbase.custom . && ./pocketbase.custom serve --http=127.0.0.1:8093",
    "db:host": "cd pb && ./pocketbase serve --http=0.0.0.0:8093"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.13",
    "@astrojs/vue": "^7.1.6",
    "@fontsource-variable/oswald": "^5.3.0",
    "@jota-one/i36n": "^3.0.1",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.12",
    "dayjs": "^1.11.23",
    "marked": "^18.2.1",
    "pocketbase": "^0.29.0",
    "primevue": "^4.5.5",
    "qr-code-styling": "^1.9.2",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/ic": "^1.2.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.9",
    "daisyui": "^5.8.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "sortablejs": "^1.15.7",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.22.1"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.11"
    }
  }
}
