{
  "name": "blablind",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "test:unit": "node --experimental-strip-types --test 'tests/unit/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:clean": "node --experimental-strip-types tests/e2e/clean.ts",
    "db": "cd pb && ./pocketbase serve --http=127.0.0.1:8093",
    "db:custom": "cd pb && go build -o pocketbase.custom . && ./pocketbase.custom serve --http=127.0.0.1:8093",
    "db:host": "cd pb && ./pocketbase serve --http=0.0.0.0:8093"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.0.2",
    "@astrojs/vue": "^7.0.1",
    "@fontsource-variable/oswald": "^5.2.5",
    "@jota-one/i36n": "^3.0.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.1.4",
    "@vueuse/core": "^14.1.0",
    "astro": "^7.0.7",
    "dayjs": "^1.11.19",
    "marked": "^17.0.1",
    "pocketbase": "^0.26.0",
    "primevue": "^4.3.5",
    "qr-code-styling": "^1.9.2",
    "tailwindcss": "^4.1.4",
    "vue": "^3.5.13",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@iconify-json/fa-solid": "^1.2.1",
    "@iconify-json/fa6-solid": "^1.1.0",
    "@iconify-json/fa7-solid": "^1.2.0",
    "@iconify-json/ic": "^1.2.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.3.5",
    "@vueuse/integrations": "^14.1.0",
    "daisyui": "^5.0.27",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.32.0",
    "oxlint-tsgolint": "^0.19.0",
    "sortablejs": "^1.15.6",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "24.14.1"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.11"
    }
  }
}
